# Auto detect text files and perform LF normalization
* text=auto

# scripts/hooks/*.py are invoked directly by their shebang line -- the
# tracked .claude/settings.json names no interpreter at all (see that
# file). `* text=auto` alone still lets a Windows checkout with
# core.autocrlf=true (Git for Windows' own recommended default) rewrite
# these to CRLF, corrupting `#!/usr/bin/env python3` into
# `#!/usr/bin/env python3\r` -- an interpreter name `env` cannot resolve.
# Force LF unconditionally so the shebang survives checkout on every OS.
scripts/hooks/*.py text eol=lf
