{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "78000"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Task",
      "Glob",
      "Grep"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "py \"C:/Users/fredc/AppData/Local/Temp/acc440/arms/treatment/scripts/hooks/spine_rail.py\" PostToolUse",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "py \"C:/Users/fredc/AppData/Local/Temp/acc440/arms/treatment/scripts/hooks/gauge_writer_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}