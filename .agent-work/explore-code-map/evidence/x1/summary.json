        "enclosing_symbol": null,
        "documentation": [
          "(module) src.analysis",
          "Analysis Module\n\nThis module provides analysis tools for F1 race data, including\nsector performance, driver consistency, and race progression.\n\nKey components:\n  - sector\\_analysis: Sector time analysis and driver comparison\n\nExample:  \n&nbsp;&nbsp;&nbsp;&nbsp;from src.analysis.sector\\_analysis import SectorAnalysis\n\n&nbsp;&nbsp;&nbsp;&nbsp;analyzer = SectorAnalysis()\nbest\\_sectors = analyzer.get\\_best\\_sectors(session\\_id=123)\nconsistency = analyzer.get\\_driver\\_consistency(session\\_id=123, driver\\_id=\"VER\")"
        ]
      },
